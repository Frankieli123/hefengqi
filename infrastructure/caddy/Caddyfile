{
	email {$ACME_EMAIL}
	admin off
	servers {
		trusted_proxies static {$EDGEONE_TRUSTED_PROXY_RANGES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

http://:8080 {
	respond /healthz 200
}

https://{$ORIGIN_HOST}:8443 {
	tls {
		dns tencentcloud {
			secret_id {$TENCENTCLOUD_SECRET_ID}
			secret_key {$TENCENTCLOUD_SECRET_KEY}
		}
	}

	@invalid_origin not header X-HFQ-Origin {$ORIGIN_SHARED_SECRET}
	respond @invalid_origin 403

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /u/* {
		reverse_proxy umami:3000
	}

	handle /_next/static/* {
		reverse_proxy web:3000 {
			header_up Host {$PUBLIC_HOST}
			header_up X-Forwarded-Host {$PUBLIC_HOST}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	reverse_proxy web:3000 {
		header_up Host {$PUBLIC_HOST}
		header_up X-Forwarded-Host {$PUBLIC_HOST}
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
		header_down Cache-Control "private, no-store, max-age=0, must-revalidate"
		header_down CDN-Cache-Control "no-store"
		health_uri /api/health/ready
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
