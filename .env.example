# Public site (runtime server configuration)
SITE_URL=https://www.example.com
PUBLIC_HOST=www.example.com
SITE_CONTENT_UPDATED_AT=2026-09-07T00:00:00.000Z
ORIGIN_HOST=origin.example.com
ACME_EMAIL=ops@example.com
ORIGIN_SHARED_SECRET=replace-with-at-least-32-random-bytes
EDGEONE_TRUSTED_PROXY_RANGES=192.0.2.0/24 2001:db8::/32

# Application image
APP_IMAGE=ghcr.io/your-org/hefengqi
IMAGE_TAG=latest

# PostgreSQL — use URL-safe random passwords
POSTGRES_USER=hefengqi
POSTGRES_PASSWORD=replace-with-url-safe-random-password
POSTGRES_DB=hefengqi
UMAMI_DB_PASSWORD=replace-with-url-safe-random-password

# Authentication and privacy
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Optional comma-separated preview/admin origins in addition to SITE_URL.
BETTER_AUTH_TRUSTED_ORIGINS=
IP_HASH_SECRET=replace-with-at-least-32-random-bytes
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=HEFENGQI <inquiries@example.com>
SALES_EMAIL=sales@example.com

# OpenAI-compatible service (optional until AI import is enabled)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# AI Product Ingest API Key (for external AI models/agents)
AI_API_KEY=replace-with-at-least-32-random-bytes

# Tencent DNS-01 for the non-public origin hostname
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# EdgeOne exact cache purge API adapter
EDGEONE_PURGE_ENDPOINT=
EDGEONE_API_TOKEN=

# Umami
UMAMI_APP_SECRET=replace-with-at-least-32-random-bytes
UMAMI_WEBSITE_ID=b1d58872-d6a6-48c0-bf28-7f8294583e98
UMAMI_SCRIPT_URL=/u/script.js

# Encrypted remote MinIO/restic backup
MINIO_ENDPOINT=https://minio-backup.example.com
MINIO_BUCKET=website-backups
MINIO_PREFIX=hefengqi-production
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
RESTIC_PASSWORD=replace-with-long-offline-stored-passphrase
BACKUP_INTERVAL_SECONDS=86400
