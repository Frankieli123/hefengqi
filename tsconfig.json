{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "next-guide-links-check/types/**/*.ts",
    "next-guide-links-check/dev/types/**/*.ts",
    "next-ru-home-check/types/**/*.ts",
    "next-ru-home-check/dev/types/**/*.ts",
    "next-news-copy-check/types/**/*.ts",
    "next-news-copy-check/dev/types/**/*.ts",
    "next-social-preview-check/types/**/*.ts",
    "next-social-preview-check/dev/types/**/*.ts",
    "next-build/types/**/*.ts",
    "next-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "current",
    ".releases",
    "next-build/standalone",
    "**/standalone/**"
  ]
}
